{
  "name": "omie-orquestrador",
  "version": "0.1.0",
  "private": true,
  "description": "Backend orquestrador entre a Omie e servicos externos. Fase 1: conciliador bancario automatico (Omie x Open Finance via Pluggy).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copiar-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.all.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "demo": "tsx scripts/servidor-demo.ts",
    "clientes": "tsx src/cli/clientes.ts",
    "conciliar": "tsx src/cli/conciliar.ts",
    "smoke:omie": "tsx scripts/smoke-omie.ts",
    "smoke:pluggy": "tsx scripts/smoke-pluggy.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pluggy-sdk": "^0.90.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
