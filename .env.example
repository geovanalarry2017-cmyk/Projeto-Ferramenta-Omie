# Copie para .env e preencha. O .env nunca vai pro git.
#
# ATENCAO: a credencial da Omie NAO fica aqui.
# Cada cliente tem a sua, guardada cifrada no banco.
# Cadastre com:  npm run clientes -- criar --slug acme --nome "Acme Ltda"

# ---------- Banco ----------
# Neon/Supabase entregam a string pronta. Precisa de SSL.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ---------- Chave de cifragem das credenciais dos clientes ----------
# 32 bytes em hex. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# PERDER ESTA CHAVE TORNA AS CREDENCIAIS DOS CLIENTES IRRECUPERAVEIS.
# Guarde uma copia em cofre de senha. Trocar a chave exige recadastrar todos.
CREDENCIAIS_CHAVE=

# ---------- Chave que assina o cookie de sessao dos usuarios ----------
# 32 bytes em hex, mesmo jeito de gerar da chave acima. Diferente dela de
# proposito: nao cifra nada guardado, so autentica o cookie de login — trocar
# esta so desloga todo mundo, nao perde credencial nenhuma.
SESSAO_CHAVE=

# ---------- Omie ----------
OMIE_BASE_URL=https://app.omie.com.br/api/v1

# ---------- HTTP ----------
PORT=3000
LOG_LEVEL=info
# Token para automacao/scripts internos via header X-API-Token — nao e o que
# o dashboard usa (ele loga por usuario, cookie de sessao).
API_TOKEN=troque-este-valor
