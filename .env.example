# Copie para .env e preencha. O .env nunca vai pro git.
#
# ATENCAO: as credenciais de Omie e Pluggy NAO ficam aqui.
# Cada cliente tem as suas, guardadas cifradas no banco.
# Cadastre com:  npm run clientes -- criar --slug acme --nome "Acme Ltda"

# ---------- Banco ----------
# Neon/Supabase entregam a string pronta. Precisa de SSL.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ---------- Chave de cifragem das credenciais dos clientes ----------
# 32 bytes em hex. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# PERDER ESTA CHAVE TORNA AS CREDENCIAIS DOS CLIENTES IRRECUPERAVEIS.
# Guarde uma copia em cofre de senha. Trocar a chave exige recadastrar todos.
CREDENCIAIS_CHAVE=

# ---------- Omie ----------
OMIE_BASE_URL=https://app.omie.com.br/api/v1

# ---------- Regras de conciliacao (calibrar com uso real) ----------
# Tolerancia de dias entre a data do banco e a do lancamento na Omie.
CONCILIACAO_TOLERANCIA_DIAS=2
# Diferenca de valor ainda aceita como "mesmo movimento" (tarifa bancaria etc), em centavos.
CONCILIACAO_TOLERANCIA_VALOR_CENTAVOS=500
# Score minimo (0..1) para considerar um par realmente conciliado.
CONCILIACAO_SCORE_MINIMO=0.6
# Quantos dias para tras o job reprocessa a cada execucao.
CONCILIACAO_JANELA_DIAS=3
# Se o extrato da Omie usa valores sempre positivos, com o sinal vindo de cNatureza.
# Confirme com `npm run smoke:omie -- --cliente <slug>` antes de confiar.
OMIE_EXTRATO_SINAL_POR_NATUREZA=true

# ---------- Job ----------
# O cron roda TODOS os clientes ativos. Deixe false enquanto valida na mao.
CRON_ATIVO=false
CRON_EXPRESSAO=0 3 * * *
CRON_TIMEZONE=America/Sao_Paulo

# ---------- HTTP ----------
PORT=3000
LOG_LEVEL=info
# Token exigido no header X-API-Token em todas as rotas de dados.
API_TOKEN=troque-este-valor
