# Copie para .env e preencha. O .env nunca vai pro git.

# ---------- Omie ----------
# Chaves do app criado em https://app.omie.com.br (Configuracoes > APIs)
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_BASE_URL=https://app.omie.com.br/api/v1

# ---------- Pluggy (Open Finance) ----------
# https://dashboard.pluggy.ai — Aplicacao > credenciais
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ---------- Banco ----------
# Neon/Supabase entregam a string pronta. Precisa de SSL.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ---------- Mapeamento conta bancaria <-> conta corrente Omie ----------
# JSON: liga cada conta do Pluggy (accountId, UUID) a uma conta corrente da Omie (nCodCC).
# Rode `npm run smoke:pluggy` e `npm run smoke:omie` para descobrir os dois lados.
# Ex.: [{"apelido":"Itau PJ","pluggyAccountId":"uuid-da-conta","omieCodigoContaCorrente":123456789}]
CONTAS_MAPEADAS=[]

# ---------- Regras de conciliacao (calibrar com uso real) ----------
# Tolerancia de dias entre a data do banco e a do lancamento na Omie.
CONCILIACAO_TOLERANCIA_DIAS=2
# Diferenca de valor ainda aceita como "mesmo movimento" (tarifa bancaria etc), em centavos.
CONCILIACAO_TOLERANCIA_VALOR_CENTAVOS=500
# Score minimo (0..1) para considerar um par realmente conciliado.
CONCILIACAO_SCORE_MINIMO=0.6
# Se o extrato da Omie usa valores sempre positivos, com o sinal vindo de cNatureza.
# Confirme rodando `npm run smoke:omie` antes de confiar no resultado.
OMIE_EXTRATO_SINAL_POR_NATUREZA=true

# ---------- Job ----------
# Cron de execucao diaria (padrao 03:00). Deixe CRON_ATIVO=false enquanto valida manualmente.
CRON_ATIVO=false
CRON_EXPRESSAO=0 3 * * *
CRON_TIMEZONE=America/Sao_Paulo
# Quantos dias para tras o job reprocessa a cada execucao (cobre lancamento atrasado no banco).
CONCILIACAO_JANELA_DIAS=3

# ---------- HTTP ----------
PORT=3000
LOG_LEVEL=info
# Token exigido no header X-API-Token para disparar a conciliacao via HTTP.
API_TOKEN=troque-este-valor
